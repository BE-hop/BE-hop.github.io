---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for entry in site.pages %}{% unless entry.sitemap == false or entry.hidden or entry.visibility == "hidden" or entry.redirect_to %}{% if entry.url contains '.html' or entry.url contains '/' %}{% unless entry.url contains '.xml' or entry.url contains '.json' or entry.url contains '.txt' or entry.url contains '.js' or entry.url contains 'offline' or entry.url == '/404.html' %}
  <url><loc>{{ entry.url | absolute_url | xml_escape }}</loc></url>
{% endunless %}{% endif %}{% endunless %}{% endfor %}
{% for collection in site.collections %}{% if collection.output %}{% for entry in collection.docs %}{% unless entry.sitemap == false or entry.hidden or entry.visibility == "hidden" or entry.redirect_to %}
  <url><loc>{{ entry.url | absolute_url | xml_escape }}</loc></url>
{% endunless %}{% endfor %}{% endif %}{% endfor %}
</urlset>
